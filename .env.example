APP_NAME=Enterprise Research Agent
APP_ENV=development
MAX_STEPS=8
RUN_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=5
MAX_PARALLEL_TOOLS=4
LLM_PROVIDER=deterministic
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=45

KNOWLEDGE_BACKEND=memory
KNOWLEDGE_DEFAULT_TENANT=demo
KNOWLEDGE_DEFAULT_PRINCIPAL=demo-user
# Required to enable POST /api/knowledge/documents
# KNOWLEDGE_ADMIN_TOKEN=replace-with-a-long-random-secret
# Enable only behind a trusted gateway that strips and rewrites access headers.
KNOWLEDGE_TRUST_ACCESS_HEADERS=false
KNOWLEDGE_EMBEDDING_DIMENSIONS=256
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
# KNOWLEDGE_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_knowledge
# QDRANT_API_KEY=replace-with-qdrant-api-key

# P0.2.2 public web integrations remain disabled by default.
WEB_SEARCH_BACKEND=stub
# WEB_SEARCH_BACKEND=brave
# BRAVE_SEARCH_API_KEY=replace-with-brave-search-token
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
WEB_SEARCH_TIMEOUT_SECONDS=10

HTTP_FETCH_BACKEND=stub
# HTTP_FETCH_BACKEND=safe
# Exact hosts or dot-prefixed subdomain suffixes, comma separated.
# HTTP_ALLOWED_HOSTS=www.example.com,.example.org
HTTP_FETCH_TIMEOUT_SECONDS=10
HTTP_FETCH_MAX_BYTES=1000000
HTTP_FETCH_MAX_REDIRECTS=3
HTTP_FETCH_ALLOW_HTTP=false
# P0.3 PostgreSQL capability remains disabled by default. The configured role
# must itself have only SELECT privileges to the approved schemas.
SQL_BACKEND=stub
# SQL_BACKEND=postgres
# POSTGRES_DSN=postgresql://research_readonly:replace-me@localhost:5432/research
POSTGRES_ALLOWED_SCHEMAS=public
POSTGRES_QUERY_TIMEOUT_MS=5000
POSTGRES_MAX_ROWS=500
# P0 Python calculation stays stubbed unless explicitly enabled.
PYTHON_BACKEND=stub
# PYTHON_BACKEND=isolated
PYTHON_WORKER_TIMEOUT_SECONDS=5
PYTHON_WORKER_MAX_OUTPUT_BYTES=65536

# Browser is an explicit interactive fallback. Approved public HTTPS hosts only.
BROWSER_BACKEND=stub
# BROWSER_BACKEND=playwright
# BROWSER_ALLOWED_HOSTS=app.example.com,.approved.example
BROWSER_TIMEOUT_SECONDS=15

# MCP tools and HTTPS transport endpoints are server configured; high-risk tools are rejected.
# MCP_ALLOWED_HOSTS=mcp-gateway.example.com
# MCP_SERVERS_JSON=[{"server":"project","name":"get_metadata","description":"Read project metadata","input_schema":{"type":"object"},"permission":"low","transport_url":"https://mcp-gateway.example.com/tools/call"}]

# Durable conversation/run storage; disabled by default.
STATE_BACKEND=memory
# STATE_BACKEND=postgres
# STATE_POSTGRES_DSN=postgresql://agent_state:replace-me@localhost:5432/research

# Optional Redis buffer for real-time SSE event recovery.
# REDIS_URL=redis://localhost:6379/0
REDIS_EVENT_TTL_SECONDS=3600
